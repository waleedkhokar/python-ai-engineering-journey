<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  AdmissionXAI - main.fxml
  Roster-only screen. Selecting a student opens a separate details window
  (results.fxml / ResultController) instead of a right-side panel, so this
  screen stays compact and nothing gets clipped by window height.
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.admissionxai.controller.MainController"
            prefWidth="980.0" prefHeight="620.0"
            minWidth="860.0" minHeight="520.0"
            styleClass="root-pane">

    <!-- ============================= TOP BAR ============================= -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" prefHeight="70.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="0" right="28" bottom="0" left="28"/>
            </padding>
            <VBox alignment="CENTER_LEFT" spacing="1">
                <Label text="AdmissionXAI" styleClass="app-title"/>
                <Label text="Explainable AI Candidate Decision Engine" styleClass="app-title-subscript"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Administrator" styleClass="app-subtitle"/>
        </HBox>
    </top>

    <!-- ============================== SIDEBAR ============================== -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240.0" minWidth="240.0" BorderPane.alignment="TOP_CENTER">
            <padding>
                <Insets top="26" right="18" bottom="24" left="18"/>
            </padding>

            <Label text="DATA IMPORT" styleClass="sidebar-heading"/>

            <VBox styleClass="sidebar-block" spacing="10">
                <Button fx:id="btnUpload" text="Upload CSV Dataset" onAction="#handleUploadCsv"
                        styleClass="secondary-button" maxWidth="Infinity"/>

                <Label text="ACTIVE FILE" styleClass="sidebar-micro-heading"/>
                <Label fx:id="lblFileName" text="No file selected" styleClass="file-path-label" wrapText="true"/>

                <HBox styleClass="sidebar-stat-row" alignment="CENTER_LEFT">
                    <Label text="Records" styleClass="sidebar-stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblRecordCount" text="0" styleClass="sidebar-stat-value"/>
                </HBox>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnRunXai" text="⚡  RUN XAI ANALYSIS" onAction="#handleRunXAI"
                    styleClass="primary-button" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- ============================ CANDIDATE ROSTER ============================ -->
    <center>
        <VBox styleClass="center-panel" spacing="12" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="24" right="20" bottom="24" left="20"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="1">
                    <Label text="Candidate Roster" styleClass="section-heading"/>
                    <Label text="Double-click a candidate to view feature attributions" styleClass="section-subheading"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtSearch" promptText="Search student ID..." styleClass="search-field" prefWidth="220.0"/>
            </HBox>

            <TableView fx:id="tblStudents" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="Student ID" prefWidth="140.0"/>
                    <TableColumn fx:id="colGpa" text="GPA" prefWidth="120.0"/>
                    <TableColumn fx:id="colGre" text="Test Score" prefWidth="130.0"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="160.0"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>