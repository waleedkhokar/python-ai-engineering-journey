# This app reads its API key ONLY from Streamlit secrets — there is no
# key field in the app itself. On Streamlit Cloud, go to your app's
# Settings -> Secrets and paste this content in, with your real key:
#
#   GROQ_API_KEY = "gsk_your_real_key_here"
#
# This example file is just a reference — it is never read by the app.
# Never commit a file containing your real key to GitHub.

GROQ_API_KEY = "your-groq-api-key-here"
