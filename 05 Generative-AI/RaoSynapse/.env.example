# Copy this file to .env. Never commit your real .env or API keys.

# Optional: enables real Groq responses when set.
# Without a key, the app clearly labels its built-in preview responder.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Demo accounts are seeded only when the database is first created.
# true for local evaluation; false for a production deployment.
SEED_DEMO=true

# Session lifetime in days.
SESSION_DAYS=30

# Set true only when serving the app over HTTPS.
COOKIE_SECURE=false

# Optional advanced configuration:
# DATABASE_PATH=raosynapse.db
# PORT=3000
