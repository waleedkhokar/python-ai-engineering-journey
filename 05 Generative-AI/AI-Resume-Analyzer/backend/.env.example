# Reference list of environment variables and their defaults.
# The app reads real environment variables; it does not load this file automatically.
# Docker Compose and hosting platforms let you set these directly.

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Maximum upload size in megabytes
MAX_UPLOAD_MB=10

# spaCy model used for name detection
SPACY_MODEL=en_core_web_sm

# false = exact skill matching only (no model download)
USE_EMBEDDINGS=true
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.65
